pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-21'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }


stages {
    stage('Build'){
        steps{
            sh 'ls -lsh'
            sh 'cd task-manager-spring-boot/ && mvn clean package'
        }
    }
}
}