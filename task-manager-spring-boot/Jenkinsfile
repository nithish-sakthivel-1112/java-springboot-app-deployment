pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-21'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
            
        }
    }


stages {
    stage('Build'){
        steps{
            sh 'ls -lsh'
            sh 'cd task-manager-spring-boot/ && mvn -Dmaven.repo.local="$WORKSPACE/.m2/repository" clean package'
        }
    }
    stage('Static Code Analysis'){
        environment {
            SONAR_TOKEN = credentials('SONARQUBE_TOKEN')
            SONAR_HOST_URL = 'http://34.229.61.136:9000/'
            SONAR_USER_HOME = "${WORKSPACE}/.sonar"
        }
        steps{
            sh 'cd task-manager-spring-boot/ && mvn clean verify sonar:sonar -Dsonar.projectKey=task-manager-spring-boot -Dmaven.repo.local="$SONAR_USER_HOME" -Dsonar.host.url="$SONAR_HOST_URL" -Dsonar.token="$SONAR_TOKEN"'

        }
    }
}
}